DATABASE_URL=postgres://USER@localhost:5432/soloos
# Required in production (Vercel). Leave empty locally to run without a login.
APP_PASSWORD=
# Day/week boundaries for "Today", reports, etc. (default Europe/Warsaw)
APP_TIMEZONE=
NEXT_PUBLIC_OFERTOWNIK_URL=
# Static bearer token for Claude Code's MCP connection (32+ chars). Claude.ai uses OAuth instead.
MCP_TOKEN=
# Email sync (optional), e.g. IMAP_HOST=imap.example.com
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# IMAP_MAILBOXES=INBOX,INBOX.Sent
# Secret for /api/cron/email-sync (Vercel Cron sends it automatically)
CRON_SECRET=
# Claude in the app: "api" (needs ANTHROPIC_API_KEY), "runner" (local Claude Code via pnpm ai:runner) or "off"
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_RUNNER_TOKEN=
